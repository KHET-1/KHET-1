def generate_html_report(all_findings, custody, redactor=None, narrative=None):
    """Generate self-contained HTML report. No external dependencies."""

    if redactor:
        all_findings = redactor.redact_dict(all_findings)
        if narrative:
            narrative = redactor.redact(narrative)

    seal = custody.generate_vault_seal()

    # Build evidence table
    evidence_rows = ''
    for e in seal['entries']:
        if e['role'] == 'evidence':
            name = redactor.redact(e['filename']) if redactor else e['filename']
            evidence_rows += f"<tr><td>{name}</td><td>{e['size_bytes']:,}</td><td class='mono'>{e['sha256']}</td><td>VERIFIED</td></tr>"

    # Build findings sections
    findings_html = ''
    for f in all_findings:
        fname = redactor.redact(f['filename']) if redactor else f['filename']
        findings_html += f"<h3>{fname} ({f['packets']} packets, {f['duration_seconds']:.1f}s)</h3>"

        if f.get('beacon_candidates'):
            findings_html += "<h4>Beacon Candidates (Regular Interval Traffic)</h4><table>"
            findings_html += "<tr><th>Destination</th><th>Interval</th><th>Std Dev</th><th>Regularity</th></tr>"
            for b in f['beacon_candidates']:
                dst = redactor.redact(b['destination']) if redactor else b['destination']
                findings_html += f"<tr><td class='mono'>{dst}</td><td>{b['mean_interval_seconds']}s</td><td>{b['std_deviation']}s</td><td>{b['regularity']:.0%}</td></tr>"
            findings_html += "</table>"

        if f.get('tls_sni'):
            findings_html += "<h4>Encrypted Destinations (TLS SNI)</h4><table>"
            findings_html += "<tr><th>Server Name</th><th>Connections</th></tr>"
            for s in f['tls_sni'][:10]:
                findings_html += f"<tr><td class='mono'>{s['server_name']}</td><td>{s['count']}</td></tr>"
            findings_html += "</table>"

        if f.get('dns_queries'):
            findings_html += "<h4>DNS Queries</h4><table>"
            findings_html += "<tr><th>Domain</th><th>Count</th></tr>"
            for d in f['dns_queries'][:10]:
                findings_html += f"<tr><td class='mono'>{d['domain']}</td><td>{d['count']}</td></tr>"
            findings_html += "</table>"

        if f.get('http_requests'):
            findings_html += "<h4>HTTP Requests (Cleartext)</h4><table>"
            findings_html += "<tr><th>Method</th><th>Host</th><th>URI</th><th>User-Agent</th></tr>"
            for r in f['http_requests'][:10]:
                host = redactor.redact(r['host']) if redactor else r['host']
                findings_html += f"<tr><td>{r['method']}</td><td class='mono'>{host}</td><td class='mono'>{r['uri']}</td><td>{r['user_agent'][:40]}</td></tr>"
            findings_html += "</table>"

    narrative_section = ''
    if narrative:
        narrative_section = f"""
        <h2>Analyst Narrative</h2>
        <div class="narrative">{narrative.replace(chr(10), '<br>')}</div>
        <p class="meta">Generated by: Local LLM (Ollama) — no data left this device.</p>
        """

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>StarFire Forensics Report</title>
<style>
body {{ font-family:Georgia,serif; max-width:820px; margin:2rem auto; padding:0 2rem; color:#1a1a1a; line-height:1.75; }}
h1 {{ text-align:center; font-size:1.4rem; }}
h2 {{ border-bottom:2px solid #333; padding-bottom:0.3rem; margin-top:2rem; }}
h3 {{ margin-top:1.5rem; }}
h4 {{ margin-top:1rem; font-size:0.9rem; }}
table {{ width:100%; border-collapse:collapse; margin:0.75rem 0; font-size:0.85rem; }}
th,td {{ border:1px solid #ccc; padding:0.4rem 0.6rem; text-align:left; }}
th {{ background:#f0f0f0; }}
.mono {{ font-family:'Courier New',monospace; font-size:0.8rem; }}
.meta {{ font-size:0.75rem; color:#666; font-style:italic; }}
.seal {{ border:2px solid #333; padding:1rem; margin:1rem 0; background:#f5f8f5; }}
.narrative {{ background:#f9f9f9; border:1px solid #ddd; padding:1rem; margin:0.75rem 0; line-height:1.8; }}
@media print {{ body {{ font-size:10.5pt; }} }}
</style>
</head>
<body>
<h1>NETWORK FORENSIC ANALYSIS REPORT</h1>
<p style="text-align:center;">StarFire Forensics Toolkit — Standalone Analysis<br>
<span class="meta">Mode: {'OFFLINE (No AI, No Network)' if not narrative else 'LOCAL LLM (Ollama, No Cloud)'} | Generated: {seal['seal_time']}</span></p>

<h2>Chain of Custody</h2>
<div class="seal">
<p><strong>Vault Seal:</strong> <span class="mono">{seal['vault_seal_sha256']}</span></p>
<p><strong>Network calls made:</strong> 0 | <strong>AI API calls made:</strong> 0</p>
<p><strong>Analysis start:</strong> {seal['start_time']} | <strong>Sealed:</strong> {seal['seal_time']}</p>
</div>

<h2>Evidence Examined</h2>
<table>
<tr><th>File</th><th>Size (bytes)</th><th>SHA-256</th><th>Status</th></tr>
{evidence_rows}
</table>

{narrative_section}

<h2>Technical Findings</h2>
{findings_html}

<div class="seal" style="margin-top:2rem;">
<p><strong>VAULT SEAL:</strong> <span class="mono">{seal['vault_seal_sha256']}</span></p>
<p class="meta">This hash covers all evidence hashes and analysis outputs. Verify: hash the custody.json file with SHA-256.</p>
</div>
</body>
</html>"""

    return html


# ============================================================
# CLI
# ============================================================

def main():
    parser = argparse.ArgumentParser(
        description='StarFire Forensics — Standalone PCAP Analysis',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ./starfire analyze capture.pcap --offline --report html
  ./starfire analyze *.pcapng --local-llm --redact-internal --report pdf
  ./starfire analyze evidence/ --offline --redact-map redactions.json
        """)

    sub = parser.add_subparsers(dest='command')
    analyze = sub.add_parser('analyze', help='Analyze pcap files')
    analyze.add_argument('files', nargs='+', help='PCAP/PCAPNG files or directories')
    analyze.add_argument('--offline', action='store_true', default=True,
                        help='Pure offline analysis, no AI (default)')
    analyze.add_argument('--local-llm', action='store_true',
                        help='Use local Ollama model for narrative generation')
    analyze.add_argument('--model', default='llama3.1:8b',
                        help='Ollama model name (default: llama3.1:8b)')
    analyze.add_argument('--redact', action='store_true',
                        help='Enable redaction (use with --redact-map or --redact-internal)')
    analyze.add_argument('--redact-internal', action='store_true',
                        help='Auto-redact all RFC1918 (internal) IP addresses')
    analyze.add_argument('--redact-map', help='Path to redaction map JSON file')
    analyze.add_argument('--report', choices=['html', 'json', 'both'], default='html',
                        help='Output format (default: html)')
    analyze.add_argument('--output', '-o', default='.',
                        help='Output directory (default: current)')

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    if args.command == 'analyze':
        print("StarFire Forensics — Standalone Analysis")
        print(f"Mode: {'LOCAL LLM' if args.local_llm else 'OFFLINE (No AI)'}")
        print(f"Network calls: BLOCKED")
        print()

        # Collect pcap files
        pcap_files = []
        for f in args.files:
            p = Path(f)
            if p.is_dir():
                pcap_files.extend(p.glob('*.pcap'))
                pcap_files.extend(p.glob('*.pcapng'))
            elif p.is_file():
                pcap_files.append(p)

        if not pcap_files:
            print("No pcap files found.")
            sys.exit(1)

        print(f"Evidence files: {len(pcap_files)}")

        # Chain of custody
        custody = ChainOfCustody()
        for f in pcap_files:
            entry = custody.seal_file(f, 'evidence')
            print(f"  SEALED: {f.name} | SHA-256: {entry['sha256'][:32]}...")

        # Redaction
        redactor = None
        if args.redact or args.redact_internal or args.redact_map:
            redactor = Redactor(redact_internal=args.redact_internal)
            if args.redact_map:
                redactor.load_map(args.redact_map)

        # Analyze
        print()
        all_findings = []
        for f in pcap_files:
            print(f"Analyzing: {f.name}...")
            findings = analyze_pcap(f)
            all_findings.append(findings)
            print(f"  {findings['packets']} packets | {findings['duration_seconds']:.1f}s | "
                  f"{len(findings.get('beacon_candidates',[]))} beacons | "
                  f"{len(findings.get('tls_sni',[]))} TLS destinations")

        # Local LLM narrative (optional)
        narrative = None
        if args.local_llm:
            print()
            print("Generating narrative (local LLM)...")
            narrative = generate_narrative_local(all_findings, args.model)
            print(f"  Generated: {len(narrative)} chars")

        # Generate report
        output_dir = Path(args.output)
        output_dir.mkdir(parents=True, exist_ok=True)

        if args.report in ('html', 'both'):
            html = generate_html_report(all_findings, custody, redactor, narrative)
            html_path = output_dir / 'starfire_report.html'
            html_path.write_text(html)
            custody.seal_output(html_path, 'report')
            print(f"\nReport: {html_path}")

        if args.report in ('json', 'both'):
            json_out = {
                'findings': all_findings,
                'narrative': narrative
            }
            if redactor:
                json_out = redactor.redact_dict(json_out)
            json_path = output_dir / 'starfire_report.json'
            json_path.write_text(json.dumps(json_out, indent=2, default=str))
            custody.seal_output(json_path, 'report')
            print(f"JSON:   {json_path}")

        # Write custody file
        seal = custody.generate_vault_seal()
        custody_path = output_dir / 'custody.json'
        custody_path.write_text(json.dumps(seal, indent=2))
        print(f"Custody: {custody_path}")
        print(f"\nVAULT SEAL: {seal['vault_seal_sha256']}")
        print(f"Network calls: 0 | AI API calls: 0")


if __name__ == '__main__':
    main()
