#!/usr/bin/env python3
"""
StarFire Forensics Toolkit — Standalone / Airgap
No cloud. No API. No telemetry. Runs fully offline.

Usage:
    ./starfire analyze <pcap_files...> [options]
    ./starfire analyze /path/to/*.pcapng --offline --redact --report html
    ./starfire analyze capture.pcap --local-llm --report pdf
"""

import sys
import os
import json
import hashlib
import argparse
import subprocess
from pathlib import Path
from datetime import datetime, timezone
from collections import defaultdict, Counter

# Ensure no network calls
os.environ['NO_PROXY'] = '*'
os.environ['no_proxy'] = '*'


# ============================================================
# CHAIN OF CUSTODY
# ============================================================

class ChainOfCustody:
    """Tracks every input/output with SHA-256. No network. No cloud."""

    def __init__(self):
        self.entries = []
        self.start_time = datetime.now(timezone.utc).isoformat()

    def seal_file(self, path, role='evidence'):
        p = Path(path)
        if not p.exists():
            return None
        data = p.read_bytes()
        h = hashlib.sha256(data).hexdigest()
        entry = {
            'file': str(p.absolute()),
            'filename': p.name,
            'role': role,
            'size_bytes': len(data),
            'sha256': h,
            'sealed_at': datetime.now(timezone.utc).isoformat()
        }
        self.entries.append(entry)
        return entry

    def seal_output(self, path, role='report'):
        return self.seal_file(path, role)

    def generate_vault_seal(self):
        content = json.dumps(self.entries, sort_keys=True)
        vault_hash = hashlib.sha256(content.encode()).hexdigest()
        return {
            'operation': 'StarFire Forensics — Standalone Analysis',
            'mode': 'OFFLINE — No network, no cloud, no AI API calls',
            'start_time': self.start_time,
            'seal_time': datetime.now(timezone.utc).isoformat(),
            'vault_seal_sha256': vault_hash,
            'entries': self.entries,
            'network_calls_made': 0,
            'ai_api_calls_made': 0
        }


# ============================================================
# REDACTION ENGINE
# ============================================================

class Redactor:
    """Replaces sensitive values in output. Configurable map or auto."""

    def __init__(self, redact_map=None, redact_internal=False):
        self.map = redact_map or {}
        self.auto_internal = redact_internal
        self.auto_counter = 0

    def load_map(self, path):
        self.map = json.loads(Path(path).read_text())

    def redact(self, text):
        result = str(text)
        for original, replacement in self.map.items():
            result = result.replace(original, replacement)
        if self.auto_internal:
            import re
            # Auto-redact RFC1918 addresses
            def replace_ip(match):
                ip = match.group(0)
                if ip not in self.map:
                    self.auto_counter += 1
                    self.map[ip] = f"INTERNAL-{self.auto_counter:03d}"
                return self.map[ip]
            result = re.sub(r'192\.168\.\d+\.\d+', replace_ip, result)
            result = re.sub(r'10\.\d+\.\d+\.\d+', replace_ip, result)
            result = re.sub(r'172\.(1[6-9]|2\d|3[01])\.\d+\.\d+', replace_ip, result)
        return result

    def redact_dict(self, d):
        """Recursively redact all string values in a dict."""
        if isinstance(d, str):
            return self.redact(d)
        elif isinstance(d, dict):
            return {k: self.redact_dict(v) for k, v in d.items()}
        elif isinstance(d, list):
            return [self.redact_dict(i) for i in d]
        return d


# ============================================================
# PCAP ANALYSIS (No network, no AI)
# ============================================================

SERVICES = {
    20: 'FTP-Data', 21: 'FTP', 22: 'SSH', 23: 'Telnet', 25: 'SMTP',
    53: 'DNS', 67: 'DHCP', 68: 'DHCP', 80: 'HTTP', 110: 'POP3',
    123: 'NTP', 143: 'IMAP', 443: 'HTTPS', 445: 'SMB', 993: 'IMAPS',
    3306: 'MySQL', 3389: 'RDP', 5432: 'PostgreSQL', 6379: 'Redis',
    8080: 'HTTP-Alt', 8443: 'HTTPS-Alt', 27017: 'MongoDB'
}


def analyze_pcap(pcap_path):
    """Full algorithmic analysis. Zero AI. Zero network."""
    import pyshark

    results = {
        'file': str(pcap_path),
        'filename': Path(pcap_path).name,
        'packets': 0,
        'duration_seconds': 0,
        'protocols': {},
        'top_sources': [],
        'top_destinations': [],
        'top_conversations': [],
        'port_analysis': [],
        'dns_queries': [],
        'tls_sni': [],
        'beacon_candidates': [],
        'anomalies': [],
        'http_requests': []
    }

    cap = pyshark.FileCapture(str(pcap_path), keep_packets=True)
    cap.load_packets()
    results['packets'] = len(cap)

    if len(cap) < 2:
        cap.close()
        return results

    results['first_packet'] = str(cap[0].sniff_time)
    results['last_packet'] = str(cap[-1].sniff_time)
    results['duration_seconds'] = (cap[-1].sniff_time - cap[0].sniff_time).total_seconds()

    # Counters
    protocols = Counter()
    src_ips = Counter()
    dst_ips = Counter()
    conversations = Counter()
    ports = Counter()
    dns_queries = Counter()
    tls_sni = Counter()
    http_reqs = []

    # Per-destination timing (for beacon detection)
    dst_times = defaultdict(list)

    for pkt in cap:
        protocols[pkt.highest_layer] += 1
        length = int(pkt.length)

        try:
            src = pkt.ip.src
            dst = pkt.ip.dst
            src_ips[src] += 1
            dst_ips[dst] += 1
            conversations[f"{src} -> {dst}"] += 1
            dst_times[dst].append(pkt.sniff_time)
        except AttributeError:
            continue

        # Ports
        try:
            transport = pkt.transport_layer
            if transport:
                dport = int(pkt[transport].dstport)
                ports[dport] += 1
        except (AttributeError, TypeError, ValueError):
            pass

        # DNS
        try:
            if hasattr(pkt, 'dns') and hasattr(pkt.dns, 'qry_name'):
                dns_queries[pkt.dns.qry_name] += 1
        except:
            pass

        # TLS SNI
        try:
            if hasattr(pkt, 'tls'):
                sni = getattr(pkt.tls, 'handshake_extensions_server_name', None)
                if sni:
                    tls_sni[sni] += 1
        except:
            pass

        # HTTP
        try:
            if hasattr(pkt, 'http') and hasattr(pkt.http, 'request_method'):
                http_reqs.append({
                    'method': pkt.http.request_method,
                    'host': getattr(pkt.http, 'host', ''),
                    'uri': getattr(pkt.http, 'request_uri', ''),
                    'src': src,
                    'dst': dst,
                    'user_agent': getattr(pkt.http, 'user_agent', '')
                })
        except:
            pass

    cap.close()

    # Beacon detection (regular intervals)
    import statistics
    for dst, times in dst_times.items():
        if len(times) < 5:
            continue
        sorted_times = sorted(times)
        intervals = [(sorted_times[i+1] - sorted_times[i]).total_seconds()
                     for i in range(len(sorted_times)-1)]
        intervals = [i for i in intervals if i > 0.5]  # filter sub-second
        if len(intervals) >= 4:
            mean = statistics.mean(intervals)
            if mean > 0:
                std = statistics.stdev(intervals) if len(intervals) > 1 else 0
                if std < mean * 0.4 and mean < 300:
                    results['beacon_candidates'].append({
                        'destination': dst,
                        'mean_interval_seconds': round(mean, 2),
                        'std_deviation': round(std, 2),
                        'sample_count': len(intervals),
                        'regularity': round(1 - (std / mean), 3) if mean > 0 else 0
                    })

    # Build results
    results['protocols'] = dict(protocols.most_common(15))
    results['top_sources'] = [{'ip': ip, 'packets': c} for ip, c in src_ips.most_common(10)]
    results['top_destinations'] = [{'ip': ip, 'packets': c} for ip, c in dst_ips.most_common(10)]
    results['top_conversations'] = [{'flow': f, 'packets': c} for f, c in conversations.most_common(10)]
    results['port_analysis'] = [{'port': p, 'service': SERVICES.get(p, ''), 'packets': c}
                                for p, c in ports.most_common(20)]
    results['dns_queries'] = [{'domain': d, 'count': c} for d, c in dns_queries.most_common(20)]
    results['tls_sni'] = [{'server_name': s, 'count': c} for s, c in tls_sni.most_common(20)]
    results['http_requests'] = http_reqs[:30]

    return results


# ============================================================
# LOCAL LLM INTEGRATION (Ollama — fully offline)
# ============================================================

def generate_narrative_local(findings, model='llama3.1:8b'):
    """Generate plain-language narrative using local Ollama model. No internet."""
    try:
        prompt = f"""You are a network forensics analyst. Based on the following technical findings, 
write a clear, professional narrative explanation suitable for a non-technical reader. 
Include: what happened, who/what is involved, whether it's malicious or benign, and recommendations.
Do not invent facts beyond what the data shows.

FINDINGS:
{json.dumps(findings, indent=2, default=str)[:8000]}

Write the narrative:"""

        result = subprocess.run(
            ['ollama', 'run', model, prompt],
            capture_output=True, text=True, timeout=120,
            env={**os.environ, 'OLLAMA_HOST': 'http://127.0.0.1:11434'}
        )
        if result.returncode == 0:
            return result.stdout.strip()
        else:
            return f"[Local LLM unavailable: {result.stderr[:200]}]"
    except FileNotFoundError:
        return "[Ollama not installed. Install: curl -fsSL https://ollama.com/install.sh | sh && ollama pull llama3.1:8b]"
    except subprocess.TimeoutExpired:
        return "[Local LLM timed out. Try a smaller model: ollama pull llama3.2:3b]"


# ============================================================
# REPORT GENERATION
